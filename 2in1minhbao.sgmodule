#!name = minhbaopremium
#!desc = Loc và Youtube
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[General]

[Script]
# 1. Locket Script (Chạy từ Cloudflare Worker của bạn)
Locket-Mod = type=http-response,pattern=^https:\/\/api\.locket\.camera\/,requires-body=true,script-path=https://5smainminhbaoshin.git212010.workers.dev/minhbao5s.sgmodule

# 2. YouTube Script (Chạy từ file module YouTube trên GitHub của bạn)
YouTube-Filter = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei/v1\/(browse|next|player|search|reel_watch_sequence|guide|account/get_setting|get_watch),requires-body=true,max-size=-1,binary-body-mode=true,script-path=https://raw.githubusercontent.com/vie-mb/baobao/refs/heads/main/ytpmbinhbao.sgmodule

[MitM]
hostname = %APPEND% youtubei.googleapis.com, api.locket.camera
